{
  "label": "factory",
  "baseBranch": null,
  "concurrency": 3,
  "maxRounds": 3,
  "maxGateFailures": 5,
  "planReview": "high-pain",
  "specReview": true,
  "maxSpecRounds": 2,
  "setup": null,
  "checks": [
    {
      "name": "test",
      "cmd": "node --test test/"
    }
  ],
  "models": {
    "intake": "fable",
    "spec": "opus",
    "grill": "opus",
    "builder": "opus",
    "approver": "opus",
    "reviewer": {
      "low": "sonnet",
      "medium": "sonnet",
      "high": "opus"
    }
  },
  "approval": {
    "autoMerge": true,
    "mergeMethod": "squash",
    "auditRate": 0.2,
    "escalateRisk": [
      "high"
    ],
    "escalatePaths": [
      "**/migrations/**",
      "**/billing/**",
      "**/auth/**",
      ".github/**",
      "factory/**",
      ".claude/**"
    ]
  },
  "slop": {
    "mode": "fail",
    "maxDiffLines": 800,
    "maxNewFileLines": 500,
    "ignorePaths": [
      "factory/lib/core.mjs"
    ]
  },
  "collect": {
    "label": "factory:triage",
    "autoQueue": false,
    "maxPerRun": 5,
    "sources": [
      {
        "type": "inbox",
        "dir": "factory/inbox"
      }
    ]
  },
  "skills": {
    "autoInstall": true,
    "installer": "npx -y skills add",
    "sources": [
      {
        "source": "addyosmani/agent-skills",
        "claudePlugin": "agent-skills@addy-agent-skills",
        "skills": [
          "spec-driven-development",
          "planning-and-task-breakdown",
          "interview-me",
          "doubt-driven-development",
          "incremental-implementation",
          "test-driven-development",
          "source-driven-development",
          "debugging-and-error-recovery",
          "frontend-ui-engineering",
          "git-workflow-and-versioning",
          "code-review-and-quality",
          "code-simplification",
          "security-and-hardening",
          "accessibility-engineering",
          "browser-testing-with-devtools",
          "shipping-and-launch"
        ]
      },
      {
        "source": "mattpocock/skills",
        "skills": [
          "grilling"
        ]
      }
    ]
  },
  "pricing": {},
  "dashboard": {
    "port": 4317
  }
}
